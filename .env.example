# Copiar este archivo como .env y ajustar los valores antes de levantar el stack:
#   cp .env.example .env
# Usar solo letras y números en las claves (van dentro de URLs de conexión).

# MinIO (también lo usan Spark, Airflow, dlt, Trino y Dremio para leer/escribir en S3)
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=cambiar_esta_clave

# Base de metadatos de Airflow (PostgreSQL)
POSTGRES_USER=airflow
POSTGRES_PASSWORD=cambiar_esta_clave

# Usuario para entrar a la interfaz web de Airflow
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=cambiar_esta_clave

# Clave para firmar sesiones del webserver. Generar una con:
#   python3 -c "import secrets; print(secrets.token_urlsafe(32))"
AIRFLOW_SECRET_KEY=generar_una_clave

# Usuario administrador de Dremio (lo crea scripts/configurar_dremio.sh en el primer arranque).
# La clave de Dremio debe tener letras y números y al menos 8 caracteres.
DREMIO_USER=admin
DREMIO_PASSWORD=cambiar1234

# En Linux poner aquí el resultado de `id -u` para que las carpetas dags/, logs/, jobs/
# sigan siendo editables por tu usuario. En Windows/Mac se puede dejar 50000.
AIRFLOW_UID=50000

# Carpeta del host con los Parquet descargados del dataset (scripts/descargar_dataset.sh).
# Se monta en Jupyter como /datos para la carga manual de Bronze.
DATOS_LOCALES=./datos
